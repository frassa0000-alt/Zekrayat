{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user ID",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 150
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar photo URL",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SavedChat": {
      "title": "SavedChat",
      "description": "User's saved chat memory and file content",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique chat memory ID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Display title of the chat memory",
          "maxLength": 100
        },
        "fileName": {
          "type": "string",
          "description": "Original uploaded text filename",
          "maxLength": 150
        },
        "fileSize": {
          "type": "number",
          "description": "Size of original file in bytes"
        },
        "rawContent": {
          "type": "string",
          "description": "Text content of the chat export",
          "maxLength": 800000
        },
        "messageCount": {
          "type": "number",
          "description": "Total parsed messages count"
        },
        "participantNames": {
          "type": "string",
          "description": "Comma-separated participant names",
          "maxLength": 300
        },
        "dateRange": {
          "type": "string",
          "description": "Date range of messages",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "title", "fileName", "rawContent", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile data"
    },
    "/users/{userId}/savedChats/{chatId}": {
      "schema": "SavedChat",
      "description": "Stores user's saved chat exports and memories"
    }
  }
}
