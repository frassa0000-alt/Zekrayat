rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt']) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500));
    }

    function isValidSavedChat(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'fileName', 'rawContent', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'fileName', 'fileSize', 'rawContent', 'messageCount', 'participantNames', 'dateRange', 'createdAt', 'updatedAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
        data.fileName is string && data.fileName.size() <= 150 &&
        data.rawContent is string && data.rawContent.size() <= 800000 &&
        (!('fileSize' in data) || data.fileSize is number) &&
        (!('messageCount' in data) || data.messageCount is number) &&
        (!('participantNames' in data) || (data.participantNames is string && data.participantNames.size() <= 300)) &&
        (!('dateRange' in data) || (data.dateRange is string && data.dateRange.size() <= 100));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Saved Chats Subcollection
      match /savedChats/{chatId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(chatId) &&
          request.resource.data.id == chatId &&
          isValidSavedChat(request.resource.data, userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(chatId) &&
          isValidSavedChat(request.resource.data, userId) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
      }
    }
  }
}
